<!DOCTYPE html>
<html>
<head lang="en">
    <meta charset="UTF-8">
    <title>Quest Results</title>
    <script src="//reports.learnosity.com/?latest-lts"></script>
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        body {
            background-image: url('/assets/playbackground.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            font-family: 'Cinzel', 'Georgia', serif;
            color: #f4e4bc;
            padding: 40px 20px;
            box-sizing: border-box;
        }

        h1 {
            max-width: 820px;
            margin: 0 auto 24px auto;
            text-align: center;
            font-family: 'Cinzel', 'Georgia', serif;
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 3px;
            color: #d4a04a;
            text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.7),
                         0 0 16px rgba(212, 160, 74, 0.4);
        }

        /* Report card — same parchment/stone look as the assessment player */
        #session-detail,
        #session-detail.learnosity-report,
        #session-detail.session-detail-by-item {
            max-width: 820px !important;
            width: auto !important;
            margin-left: auto !important;
            margin-right: auto !important;
            margin-top: 0 !important;
            margin-bottom: 40px !important;
            float: none !important;
            padding: 32px !important;
            background: rgba(20, 12, 8, 0.85) !important;
            border: 3px solid #8b6f47 !important;
            border-radius: 12px !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6),
                        inset 0 0 24px rgba(0, 0, 0, 0.5) !important;
            color: #f4e4bc !important;
        }

        /* Inherit parchment text into anything Learnosity renders inside the report */
        #session-detail,
        #session-detail * {
            font-family: 'Cinzel', 'Georgia', serif !important;
            color: #f4e4bc !important;
        }

        /* Tables Learnosity uses inside session-detail-by-item */
        #session-detail table {
            width: 100%;
            border-collapse: collapse;
            background: transparent !important;
        }
        #session-detail th,
        #session-detail td {
            padding: 10px 12px !important;
            border-bottom: 1px solid #5a3a1c !important;
            background: transparent !important;
        }
        #session-detail th {
            color: #d4a04a !important;
            font-weight: 700 !important;
            letter-spacing: 1px;
            border-bottom: 2px solid #8b6f47 !important;
        }
        #session-detail tr:hover td {
            background: rgba(212, 160, 74, 0.08) !important;
        }

        /* Score / numeric highlights */
        #session-detail .lrn-score,
        #session-detail [class*="score"] {
            color: #ffd54f !important;
            font-weight: 700 !important;
            text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
        }

        /* "Return to camp" link */
        .home-link {
            display: block;
            max-width: 820px;
            margin: 0 auto;
            text-align: center;
        }
        .home-link a {
            display: inline-block;
            padding: 12px 28px;
            background: linear-gradient(180deg, #d4a04a 0%, #8b6f47 100%);
            color: #2a1810;
            border: 2px solid #5a3a1c;
            border-radius: 8px;
            font-family: 'Cinzel', 'Georgia', serif;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 1px;
            text-decoration: none;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
            transition: transform 120ms ease, background 120ms ease;
        }
        .home-link a:hover {
            background: linear-gradient(180deg, #ffd54f 0%, #d4a04a 100%);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <h1>Quest Results</h1>
<!-- Here, we make sure to specify a div with the same id we specified for the report in the request object (on line 41) in reports.js -->
<div id="session-detail"></div>
<div class="home-link"><a href="/">Return to Camp</a></div>
<script>
    const request = <%- JSON.stringify(request) %>;
    const reportsApp = LearnosityReports.init(request, {
        readyListener() {
            console.log('ready');
        },
        errorListener(err) {
            console.log('error', err);
        }
    })
</script>
</body>
</html>
