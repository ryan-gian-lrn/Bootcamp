<!DOCTYPE html>
<html>
<head lang="en">
    <meta charset="UTF-8">
    <title>Learnosity SDK - NodeJS</title>
    <script src="//items.learnosity.com/?latest-lts"></script>
    <style>
        html, body {
            height: 100%;
            width: 100%;
            margin: 0;
        }
        body {
            background-image: url('/assets/playbackground.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            font-family: 'Cinzel', 'Georgia', serif;
            color: #f4e4bc;
        }
        h1 { display: none; }

        /* Player wrapper — center it, give it a parchment/stone card look */
        #learnosity_assess {
            max-width: 820px;
            max-height: 60vh;
            margin: 40px auto;
            padding: 32px;
            background: rgba(20, 12, 8, 0.85);
            border: 3px solid #8b6f47;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6),
                        inset 0 0 24px rgba(0, 0, 0, 0.5);
        }

        /* Question stem / prompt */
        .lrn .lrn_stimulus,
        .lrn-stimulus,
        .lrn-question .lrn_stimulus_content {
            color: #f4e4bc !important;
            font-size: 22px !important;
            line-height: 1.5 !important;
            margin-bottom: 20px;
        }

        /* MCQ options — make them look like big stone buttons */
        .lrn .lrn-mcq-option {
            display: block !important;
            padding: 16px 22px !important;
            margin: 12px 0 !important;
            background: linear-gradient(180deg, #3a2817 0%, #2a1810 100%) !important;
            color: #f4e4bc !important;
            border: 2px solid #8b6f47 !important;
            border-radius: 8px !important;
            font-size: 18px !important;
            font-family: inherit !important;
            cursor: pointer !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
            transition: transform 120ms ease, background 120ms ease, border-color 120ms ease;
        }
        .lrn .lrn-mcq-option:hover {
            background: linear-gradient(180deg, #5a3a1c 0%, #3a2010 100%) !important;
            border-color: #d4a04a !important;
            transform: translateY(-2px);
        }
        .lrn .lrn-mcq-option.lrn-selected,
        .lrn .lrn-mcq-option.lrn_selected {
            background: linear-gradient(180deg, #d35400 0%, #8b3a00 100%) !important;
            border-color: #ffd54f !important;
            color: #fff !important;
        }
        /* Hide the default radio dots / checkboxes — the whole tile is the button now */
        .lrn .lrn-mcq-option input[type="radio"],
        .lrn .lrn-mcq-option input[type="checkbox"],
        .lrn .lrn-mcq-option .lrn_mcqgroup {
            display: none !important;
        }

        /* Item / question counter at the top of the player */
        .lrn .lrn-assess-name,
        .lrn .item-pos {
            color: #d4a04a !important;
        }
        .lrn-right-region {
            display: none !important;
        }
    </style>
</head>
<body>
    <h1>Standalone Assessment Example</h1>
<!-- We create a div element with the id learnosity_assess into which the Items API will load the assessment -->
<div id="learnosity_assess"></div>
<script>
    const request = <%- JSON.stringify(request) %>;
    const itemsApp = LearnosityItems.init(request, {
        readyListener() {
            console.log('ready');
        },
        errorListener(err) {
            console.log('error', err);
        }
    });
</script>
</body>
</html>
